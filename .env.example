# Local development only. Never use these values anywhere else — in production the service
# refuses to start with this JWT secret.

NODE_ENV=development
PORT=3000

# Postgres from docker-compose.yml, published on 5433 so it does not collide with a Postgres
# already installed on the machine. Change POSTGRES_PORT and both URLs together.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://capacity:capacity@localhost:5433/capacity
TEST_DATABASE_URL=postgresql://capacity:capacity@localhost:5433/capacity_test

# Bearer tokens (HS256). `npm run token` mints one for local use.
JWT_SECRET=local-development-secret-change-me-0123456789
JWT_ISSUER=invoice-reservation-local
JWT_AUDIENCE=invoice-reservation-api

# Optional outside production, where built-in illustrative rates apply. Required in production:
# FX_RATES={"asOf":"2026-09-19T00:00:00Z","rates":{"EUR/USD":"1.09"}}

# Treasury feed over Kafka. Disabled by default so the service runs without a broker.
KAFKA_ENABLED=false
KAFKA_PORT=19092
KAFKA_BROKERS=localhost:19092
KAFKA_TREASURY_TOPIC=treasury.program-capacity
KAFKA_DEAD_LETTER_TOPIC=treasury.program-capacity.dead-letter
KAFKA_GROUP_ID=invoice-reservation-capacity
