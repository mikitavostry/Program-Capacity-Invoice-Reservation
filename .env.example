# Local development only. These credentials match docker-compose.yml.
#
# The container publishes Postgres on 5433 rather than 5432, so it does not collide with a
# Postgres already installed on the machine. Change POSTGRES_PORT and both URLs together.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://capacity:capacity@localhost:5433/capacity
TEST_DATABASE_URL=postgresql://capacity:capacity@localhost:5433/capacity_test
