# Local development only. Never use these values anywhere else — in production the service
# refuses to start with this JWT secret.

NODE_ENV=development
PORT=3000

# Postgres from docker-compose.yml, published on 5433 so it does not collide with a Postgres
# already installed on the machine. Change POSTGRES_PORT and both URLs together.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://capacity:capacity@localhost:5433/capacity
# How long a request waits for a database connection before failing with 503 (default 3000).
# DB_CONNECT_TIMEOUT_MS=3000

# Bearer tokens (HS256). `npm run token` mints one for local use.
JWT_SECRET=local-development-secret-change-me-0123456789
JWT_ISSUER=invoice-reservation-local
JWT_AUDIENCE=invoice-reservation-api

# Optional outside production, where built-in illustrative rates apply. Required in production:
# FX_RATES={"asOf":"2026-09-19T00:00:00Z","rates":{"EUR/USD":"1.09"}}

# Treasury feed over Kafka. Programs are opened and updated only by this feed, so it is on.
KAFKA_ENABLED=true
KAFKA_PORT=19092
# Kafka over HTTP (Redpanda's proxy), used by the Postman collection to publish treasury messages.
KAFKA_HTTP_PORT=18082
# Redpanda Console web UI (`npm run kafka:ui`).
KAFKA_CONSOLE_PORT=8080
KAFKA_BROKERS=localhost:19092
KAFKA_TREASURY_TOPIC=treasury.program-capacity
KAFKA_DEAD_LETTER_TOPIC=treasury.program-capacity.dead-letter
# Where this service publishes its own events (capacity.reserved, …) from the outbox.
KAFKA_CAPACITY_EVENTS_TOPIC=capacity.events
KAFKA_GROUP_ID=invoice-reservation-capacity
# Plaintext to the local broker. Production requires TLS and SASL:
# KAFKA_SSL=true
# KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/kafka-ca.pem   # optional; the system CAs otherwise
# KAFKA_SASL_MECHANISM=scram-sha-512                  # plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USERNAME=invoice-reservation
# KAFKA_SASL_PASSWORD=
